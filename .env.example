# اتصال اپلیکیشن (نقش غیر مالک؛ RLS روی آن اعمال می‌شود)
DATABASE_URL=postgres://zt_app:zt_app_password@localhost:5432/zt_hub
# اتصال مایگریشن (نقش مالک)
DATABASE_ADMIN_URL=postgres://zt_admin:zt_admin_password@localhost:5432/zt_hub
# 32 بایت base64 :  openssl rand -base64 32
APP_ENCRYPTION_KEY=
# فقط توسعه محلی: اجازه آدرس http/localhost برای فروشگاه (در production نادیده گرفته می‌شود)
ALLOW_PRIVATE_STORE_URLS=
